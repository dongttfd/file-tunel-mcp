<Window x:Class="FileMCP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileMCP" Width="980" Height="760" MinWidth="860" MinHeight="650"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Icon="Assets/filemcp.ico">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style x:Key="WorkspaceLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OverviewCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D8D8D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="OverviewLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="OverviewValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Margin="0,0,0,12">
            <TabItem Header="Overview" x:Name="OverviewTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="Overview"/>
                                <TextBlock Margin="0,3,0,0" Foreground="Gray" Text="Local FileMCP observability - selected period totals + live runtime state"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock x:Name="OverviewClockText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="OverviewAppUptimeText" Margin="0,3,0,0" Foreground="Gray" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Text="Period"/>
                            <ComboBox x:Name="OverviewPeriodCombo" Grid.Column="1" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="Today" Tag="Today"/>
                                <ComboBoxItem Content="Yesterday" Tag="Yesterday"/>
                                <ComboBoxItem Content="7 days" Tag="SevenDays"/>
                                <ComboBoxItem Content="30 days" Tag="ThirtyDays"/>
                            </ComboBox>
                            <TextBlock x:Name="OverviewPeriodRangeText" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBlock x:Name="OverviewPeriodUpdatedText" Grid.Column="3" VerticalAlignment="Center" Foreground="Gray" Text="Not loaded"/>
                        </Grid>
<Border Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="MCP tokens in (est.)"/>
                                    <TextBlock x:Name="OverviewTokenInText" Style="{StaticResource OverviewValueStyle}" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="MCP tokens out (est.)"/>
                                    <TextBlock x:Name="OverviewTokenOutText" Style="{StaticResource OverviewValueStyle}" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Total MCP tokens (est.)"/>
                                    <TextBlock x:Name="OverviewTokenTotalText" Style="{StaticResource OverviewValueStyle}" Text="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Input payload"/>
                                    <TextBlock x:Name="OverviewInputBytesText" Style="{StaticResource OverviewValueStyle}" Text="0 B"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Output payload"/>
                                    <TextBlock x:Name="OverviewOutputBytesText" Style="{StaticResource OverviewValueStyle}" Text="0 B"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Total payload"/>
                                    <TextBlock x:Name="OverviewTotalBytesText" Style="{StaticResource OverviewValueStyle}" Text="0 B"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Margin="0,4,0,8" FontWeight="SemiBold" Text="Tool activity"/>
                        <Border Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Calls"/><TextBlock x:Name="OverviewToolCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Tasks"/><TextBlock x:Name="OverviewExecutionTasksText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Read"/><TextBlock x:Name="OverviewReadCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Write"/><TextBlock x:Name="OverviewWriteCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Command"/><TextBlock x:Name="OverviewCommandCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="5"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Git"/><TextBlock x:Name="OverviewGitCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Skill"/><TextBlock x:Name="OverviewSkillCallsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                                <StackPanel Grid.Column="7"><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Errors"/><TextBlock x:Name="OverviewErrorsText" Style="{StaticResource OverviewValueStyle}" Text="0"/></StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,4,0,8" FontWeight="SemiBold" Text="Realtime activity - last 15 minutes"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Connected runtimes"/><TextBlock x:Name="OverviewConnectedRuntimesText" Style="{StaticResource OverviewValueStyle}" Text="0 / 4"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Average tool latency"/><TextBlock x:Name="OverviewAverageLatencyText" Style="{StaticResource OverviewValueStyle}" Text="0 ms"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Max tool latency"/><TextBlock x:Name="OverviewMaxLatencyText" Style="{StaticResource OverviewValueStyle}" Text="0 ms"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,10">
                                <StackPanel><TextBlock Style="{StaticResource OverviewLabelStyle}" Text="Persistent telemetry"/><TextBlock x:Name="OverviewTelemetryHealthText" Style="{StaticResource OverviewValueStyle}" Text="Starting"/></StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="Gray" Text="Calls / second and MCP token estimate / second"/>
                                    <TextBlock x:Name="OverviewRealtimeCurrentText" Grid.Column="1" Foreground="Gray" Text="Calls/s: 0 | Tokens est./s: 0"/>
                                </Grid>
                                <Canvas x:Name="OverviewRealtimeCanvas" Height="190" ClipToBounds="True" Background="#08000000">
                                    <Polyline x:Name="OverviewCallsPolyline" Stroke="#2F6FED" StrokeThickness="2"/>
                                    <Polyline x:Name="OverviewTokensPolyline" Stroke="#17A673" StrokeThickness="2"/>
                                </Canvas>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock Foreground="#2F6FED" FontWeight="SemiBold" Text="Calls/s" Margin="0,0,18,0"/>
                                    <TextBlock Foreground="#17A673" FontWeight="SemiBold" Text="MCP token est./s"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="0,4,0,8" FontWeight="SemiBold" Text="Workspaces"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Drive C"/><TextBlock x:Name="COverviewStatusText" Margin="0,5,0,0" Text="Stopped"/><TextBlock x:Name="COverviewUptimeText" Foreground="Gray" Text="Uptime: -"/><TextBlock x:Name="COverviewHealthText" Margin="0,3,0,0" Foreground="Gray" Text="MCP: down | Tunnel: down | Health: unknown"/><TextBlock x:Name="COverviewCallsText" Margin="0,6,0,0" Text="Calls: 0"/><TextBlock x:Name="COverviewTokensText" Text="MCP tokens (est.): 0"/></StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,10">
                                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Drive D"/><TextBlock x:Name="DOverviewStatusText" Margin="0,5,0,0" Text="Stopped"/><TextBlock x:Name="DOverviewUptimeText" Foreground="Gray" Text="Uptime: -"/><TextBlock x:Name="DOverviewHealthText" Margin="0,3,0,0" Foreground="Gray" Text="MCP: down | Tunnel: down | Health: unknown"/><TextBlock x:Name="DOverviewCallsText" Margin="0,6,0,0" Text="Calls: 0"/><TextBlock x:Name="DOverviewTokensText" Text="MCP tokens (est.): 0"/></StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OverviewCardStyle}">
                                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Drive E"/><TextBlock x:Name="EOverviewStatusText" Margin="0,5,0,0" Text="Stopped"/><TextBlock x:Name="EOverviewUptimeText" Foreground="Gray" Text="Uptime: -"/><TextBlock x:Name="EOverviewHealthText" Margin="0,3,0,0" Foreground="Gray" Text="MCP: down | Tunnel: down | Health: unknown"/><TextBlock x:Name="EOverviewCallsText" Margin="0,6,0,0" Text="Calls: 0"/><TextBlock x:Name="EOverviewTokensText" Text="MCP tokens (est.): 0"/></StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,10">
                                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="Drive F"/><TextBlock x:Name="FOverviewStatusText" Margin="0,5,0,0" Text="Stopped"/><TextBlock x:Name="FOverviewUptimeText" Foreground="Gray" Text="Uptime: -"/><TextBlock x:Name="FOverviewHealthText" Margin="0,3,0,0" Foreground="Gray" Text="MCP: down | Tunnel: down | Health: unknown"/><TextBlock x:Name="FOverviewCallsText" Margin="0,6,0,0" Text="Calls: 0"/><TextBlock x:Name="FOverviewTokensText" Text="MCP tokens (est.): 0"/></StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Margin="0,6,0,8" FontWeight="SemiBold" Text="AI chats"/>
                        <TextBlock x:Name="OverviewSessionSummaryText" Margin="0,0,0,8" Foreground="Gray" Text="No correlated AI chats yet."/>
                        <DataGrid x:Name="OverviewSessionsGrid" Height="190" Margin="0,0,0,10"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="OverviewSessionsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                                <DataGridTextColumn Header="Observed ID" Binding="{Binding DisplayId}" Width="150"/>
                                <DataGridTextColumn Header="Workspace" Binding="{Binding Workspaces}" Width="100"/>
                                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="150"/>
                                <DataGridTextColumn Header="Calls" Binding="{Binding Calls}" Width="80"/>
                                <DataGridTextColumn Header="Tokens est." Binding="{Binding Tokens}" Width="100"/>
                                <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Selected session detail"/>
                                <TextBlock x:Name="OverviewSessionDetailText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#444444" Text="Select an AI chat or unbound activity row."/>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                                   Text="* Token values are deterministic estimates from accepted MCP JSON payload bytes (bytes_div_4_v1). They are not ChatGPT account/model token usage."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Connection" x:Name="ConnectionTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Runtime API key"/>
                            <PasswordBox x:Name="ApiKeyBox" Grid.Column="1"
                                         ToolTip="One Runtime API key is shared by all enabled FileMCP workspaces and stored in Windows Credential Manager."/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="140,6,0,0">
                            <TextBlock x:Name="ApiKeyStatusText" VerticalAlignment="Center" Foreground="Gray"/>
                            <Button x:Name="DeleteApiKeyButton" Margin="12,0,0,0" Content="Delete API key" Click="DeleteApiKey_Click"/>
                        </StackPanel>

                        <TextBlock Margin="0,16,0,8" FontWeight="SemiBold" Text="Workspace tunnels"/>
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="Drive"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="Tunnel ID"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Text="Status"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="C"/>
                                <TextBox x:Name="CTunnelIdBox" Grid.Row="2" Grid.Column="1" Margin="0,0,10,0"/>
                                <TextBlock x:Name="CStatusText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Foreground="Gray" Text="Disabled"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="D"/>
                                <TextBox x:Name="DTunnelIdBox" Grid.Row="4" Grid.Column="1" Margin="0,0,10,0"/>
                                <TextBlock x:Name="DStatusText" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Foreground="Gray" Text="Disabled"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="E"/>
                                <TextBox x:Name="ETunnelIdBox" Grid.Row="6" Grid.Column="1" Margin="0,0,10,0"/>
                                <TextBlock x:Name="EStatusText" Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" Foreground="Gray" Text="Disabled"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="F"/>
                                <TextBox x:Name="FTunnelIdBox" Grid.Row="8" Grid.Column="1" Margin="0,0,10,0"/>
                                <TextBlock x:Name="FStatusText" Grid.Row="8" Grid.Column="2" VerticalAlignment="Center" Foreground="Gray" Text="Disabled"/>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Each enabled drive uses its own local MCP port, profile and Secure MCP Tunnel while remaining inside this single FileMCP desktop app."/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="SaveConnectionButton" Content="Save connection" Margin="0,0,8,0" Click="SaveConnection_Click"/>
                            <Button x:Name="ConnectButton" Content="Connect all" Width="130" Click="Connect_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock FontWeight="SemiBold" Text="Workspace roots"/>
                        <TextBlock Margin="0,4,0,10" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Enable the drives you want FileMCP to expose. Every workspace remains isolated to its configured root."/>

                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="Use"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="Drive"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Text="Shared directory"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" FontWeight="SemiBold" Text=""/>

                                <CheckBox x:Name="CEnabledCheckBox" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource WorkspaceLabelStyle}" Text="C"/>
                                <TextBox x:Name="CPathBox" Grid.Row="2" Grid.Column="2" Margin="0,0,8,0"/>
                                <Button Grid.Row="2" Grid.Column="3" Tag="C" Content="Browse..." Click="BrowseDirectory_Click"/>

                                <CheckBox x:Name="DEnabledCheckBox" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource WorkspaceLabelStyle}" Text="D"/>
                                <TextBox x:Name="DPathBox" Grid.Row="4" Grid.Column="2" Margin="0,0,8,0"/>
                                <Button Grid.Row="4" Grid.Column="3" Tag="D" Content="Browse..." Click="BrowseDirectory_Click"/>

                                <CheckBox x:Name="EEnabledCheckBox" Grid.Row="6" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource WorkspaceLabelStyle}" Text="E"/>
                                <TextBox x:Name="EPathBox" Grid.Row="6" Grid.Column="2" Margin="0,0,8,0"/>
                                <Button Grid.Row="6" Grid.Column="3" Tag="E" Content="Browse..." Click="BrowseDirectory_Click"/>

                                <CheckBox x:Name="FEnabledCheckBox" Grid.Row="8" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource WorkspaceLabelStyle}" Text="F"/>
                                <TextBox x:Name="FPathBox" Grid.Row="8" Grid.Column="2" Margin="0,0,8,0"/>
                                <Button Grid.Row="8" Grid.Column="3" Tag="F" Content="Browse..." Click="BrowseDirectory_Click"/>
                            </Grid>
                        </Border>

                        <CheckBox x:Name="EnableCommandsCheckBox" Margin="0,14,0,0" Content="Allow shell commands"
                                  ToolTip="Allow FileMCP to run PowerShell/CLI commands with the current Windows user's permissions."/>
                        <TextBlock Margin="24,5,0,0" Foreground="Gray" TextWrapping="Wrap"
                                   Text="Allows ChatGPT to run PowerShell/CLI commands with the current Windows user's permissions. Enable only for workspaces you trust."/>

                        <Expander x:Name="AdvancedExpander" Header="Advanced options" Margin="0,16,0,0">
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="Drive"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="Profile"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Text="MCP port"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" FontWeight="SemiBold" Text="Health listener"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="C"/>
                                    <TextBox x:Name="CProfileBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,0"/>
                                    <TextBox x:Name="CPortBox" Grid.Row="2" Grid.Column="2" Margin="0,0,8,0"/>
                                    <TextBox x:Name="CHealthBox" Grid.Row="2" Grid.Column="3"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="D"/>
                                    <TextBox x:Name="DProfileBox" Grid.Row="4" Grid.Column="1" Margin="0,0,8,0"/>
                                    <TextBox x:Name="DPortBox" Grid.Row="4" Grid.Column="2" Margin="0,0,8,0"/>
                                    <TextBox x:Name="DHealthBox" Grid.Row="4" Grid.Column="3"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="E"/>
                                    <TextBox x:Name="EProfileBox" Grid.Row="6" Grid.Column="1" Margin="0,0,8,0"/>
                                    <TextBox x:Name="EPortBox" Grid.Row="6" Grid.Column="2" Margin="0,0,8,0"/>
                                    <TextBox x:Name="EHealthBox" Grid.Row="6" Grid.Column="3"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource WorkspaceLabelStyle}" Text="F"/>
                                    <TextBox x:Name="FProfileBox" Grid.Row="8" Grid.Column="1" Margin="0,0,8,0"/>
                                    <TextBox x:Name="FPortBox" Grid.Row="8" Grid.Column="2" Margin="0,0,8,0"/>
                                    <TextBox x:Name="FHealthBox" Grid.Row="8" Grid.Column="3"/>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Git name"/>
                                    <TextBox x:Name="GitNameBox" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Git email"/>
                                    <TextBox x:Name="GitEmailBox" Grid.Row="2" Grid.Column="1"/>
                                </Grid>

                                <Border Margin="0,16,0,0" Padding="12" BorderBrush="#22000000" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <CheckBox x:Name="OtlpEnabledCheckBox" Content="Enable optional OTLP telemetry export (HTTP/Protobuf)"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="OTLP endpoint"/>
                                            <TextBox x:Name="OtlpEndpointBox" Grid.Column="1"/>
                                        </Grid>
                                        <TextBlock Margin="0,7,0,0" Foreground="Gray" TextWrapping="Wrap"
                                                   Text="Disabled by default. FileMCP exports only bounded metadata/metrics; it does not export tool arguments, file contents, raw chat handles, or baggage. Endpoint must be a base http(s) collector URI; FileMCP adds /v1/traces and /v1/metrics."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <Button x:Name="SaveSettingsButton" Content="Save settings" HorizontalAlignment="Right" Margin="0,16,0,0" Click="SaveSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logs">
                <Grid Margin="10">
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="#191919" Foreground="White"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="Gray"
                       Text="Closing the window keeps FileMCP running in the system tray."/>
            <Button Grid.Column="1" Content="Quit FileMCP" Click="Quit_Click"/>
        </Grid>
    </Grid>
</Window>
